{
  "manifest_version": 2,
  "name": "YouTube Language Loop",
  "version": "0.2.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-language-loop@imkhan3.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "description": "Configure subtitle block looping, audio dubbing, and speed ramping for language learning.",
  "permissions": [
    "storage",
    "https://*.tts.speech.microsoft.com/*"
  ],
  "background": {
    "scripts": ["tts-cache.js", "background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Language Loop"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "injected.js"
  ]
}