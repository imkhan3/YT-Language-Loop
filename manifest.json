{
  "manifest_version": 2,
  "name": "YouTube Language Loop",
  "version": "0.2.0",
  "description": "Configure subtitle block looping, audio dubbing, and speed ramping for language learning.",
  "permissions": [
    "storage"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "YouTube Language Loop"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "injected.js"
  ]
}